<%= admin_form_for @window, url: admin_event_cfp_window_path(@event), as: :cfp_window do |form| %>
  <%= form.error_notification %>
  <%= form.field_set 'Schedule' do %>
    <%= form.input :opens_at, as: :datetime, html5: true %>
    <%= form.input :closes_at, as: :datetime, html5: true %>
  <% end %>
  <%= form.field_set 'Rules' do %>
    <%= form.input :max_submissions_per_speaker %>
    <%= form.input :blind_review, hint: 'Reviewers will not see who submitted a proposal' %>
    <%= form.input :tracks, as: :text, input_html: { rows: 4 } %>
    <%= form.input :guidelines, as: :text, hint: 'Markdown is supported', input_html: { rows: 10 } %>
  <% end %>
  <%= form.buttons cancel_path: admin_event_path(@event) %>
<% end %>

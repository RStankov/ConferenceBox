- if @conference.about?
  article#about
    h1 data-label="Турнето" За Турнето
    section = markdown @conference.about

article#conferences
  h1 data-label="Къде ще бъдем" Градове
  ul
    - Conference.regular.with_events.each do |conference|
      - with_event(conference.current_event) do |event|
        li
          h3 = event.town
          p = event.information
          = link_to 'сайт на събитието', conference_url(conference), class: 'arrow'

= render 'shared/archive', events: Event.publicly_announced

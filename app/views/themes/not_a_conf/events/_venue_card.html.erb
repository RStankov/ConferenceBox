<section id="<%= id %>" class="ts-venue <%= background_class %>">
  <div class="container">
    <div class="row text-center">
      <span class="icon-wrap"><i class="fa fa-map"></i></span>
      <h2 class="section-title"><%= title %></h2>
      <div class="section-sub-title venue-card">
        <strong>
          <%= link_to name, site_url, target: '_blank' %>
          <%= address if address.present? %>
        </strong>
        <%= markdown notes if notes.present? %>
      </div>
    </div>
    <% if map_url.present? %>
      <div class="row">
        <iframe width="100%" height="460" border="none" scrolling="no" src="<%= map_url %>" class="map"></iframe>
        <div class="gap-60"></div>
      </div>
    <% end %>
  </div>
</section>

<section id="venue" class="section">
  <h3>Where</h3>
  <p>
    <strong><%= link_to current_event.venue_name, current_event.venue_site_url, target: :blank %></strong><br>
    <%= current_event.venue_address %>
  </p>
  <%= markdown current_event.venue_notes if current_event.venue_notes? %>
  <% if current_event.venue_map_embedded_url? %>
    <div class="map">
      <iframe width="100%" height="360" scrolling="no" src="<%= current_event.venue_map_embedded_url %>"></iframe>
    </div>
  <% end %>
</section>

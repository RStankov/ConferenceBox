article#speaker
  - if @speaker.photo.attached?
    - if @speaker.personal_site?
      = link_to image_tag(@speaker.photo.variant(resize: '280x280^')), @speaker.personal_site, target: '_blank', class: 'avatar'
    - else
      .avatar = image_tag @speaker.photo.variant(resize: '280x280^')

  h2 = @speaker.name

  - if @speaker.company?
    .company = @speaker.company_site? ? link_to(@speaker.company, @speaker.company_site, target: '_blank') : @speaker.company

  = render 'shared/social_links', links: @speaker.social_links

  .description = markdown @speaker.description

  ul.sessions
    - @speaker.ordered_sessions.each do |session|
      li
        strong #{link_to session.event_full_name, event_path(session.event)} - #{session.title}
        - if session.video_url?
          = link_to 'видео', session.video_url, class: 'video', target: '_blank'
        - if session.slides_url?
          = link_to 'презентация', session.slides_url, class: 'slides', target: '_blank'

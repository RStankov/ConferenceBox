<!DOCTYPE html>
<html <%= tag.attributes theme_root_attributes(current_conference.regular? ? current_event : current_conference) %>>
  <head>
    <meta charset="utf-8">
    <title><%= current_conference.name %></title>

    <%= stylesheet_link_tag 'plain' %>

    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">

    <meta content="<%= current_conference.copyright %>" name="copyright" />
    <meta content="<%= current_conference.name %>" property="og:site_name" />
    <meta content="<%= current_conference.name %>" property="og:title" />
    <meta content="website" property="og:type" />
    <meta content="<%= root_url %>" property="og:url" />

    <% if current_conference.slogan? %>
      <meta content="<%= current_conference.slogan %>" property="og:description" />
      <meta content="<%= current_conference.slogan %>" name="description" />
    <% end %>

    <% unless current_conference.main? %>
      <% if current_event.logo? %>
        <link rel="shortcut icon" href="<%= url_for current_event.favicon %>" type="image/x-icon" />
        <link rel="icon" href="<%= url_for current_event.favicon %>" type="image/x-icon" />
      <% end %>

      <% if current_event.image_for_share? %>
        <meta content="<%= rails_blob_url current_event.image_for_share %>" property="og:image" />
      <% end %>
    <% end %>

    <%= yield :meta_data %>

    <% if Rails.env.production? && current_conference.analytics_code? %>
      <%= raw current_conference.analytics_code %>
    <% end %>
  </head>

  <body>
    <nav class="site-nav">
      <div class="container">
        <%= link_to current_conference.name, root_path, class: 'brand' %>
        <ul>
          <% unless current_conference.main? %>
            <% current_event.sections.each do |section| %>
              <li><%= link_to section.humanize, current_event_path(anchor: section) %></li>
            <% end %>
          <% end %>
          <% if current_conference.code_of_conduct_url? %>
            <li><%= link_to 'Code of conduct', current_conference.code_of_conduct_url, target: :blank %></li>
          <% end %>
        </ul>
      </div>
    </nav>
    <% unless current_conference.main? %>
      <section class="hero">
        <%= image_tag current_event.logo.variant(resize: 'x120'), alt: current_conference.name if current_event.logo? %>
        <h1><%= current_conference.name %> <%= current_event.name %></h1>
        <% if current_conference.slogan? %>
          <p><%= new_line_to_break current_conference.slogan %></p>
        <% end %>
        <% if current_event.information.present? %>
          <p><%= current_event.information %></p>
        <% end %>
        <%= link_to 'Get a ticket', current_event.tickets_url, class: 'cb-button', target: :blank if current_event.tickets_url? %>
      </section>
    <% end %>
    <main class="page">
      <% if current_conference.main? %>
        <h1><%= current_conference.name %></h1>
        <h2><%= new_line_to_break current_conference.slogan %></h2>
      <% end %>
      <%= content_for?(:content) ? yield(:content) : yield %>
      <footer>
        <%= render 'shared/social_links', links: conference_social_links(current_conference) %>
        <p>Copyright <%= current_conference.copyright %>. All Rights Reserved.</p>
      </footer>
    </main>
  </body>
</html>

<% title "Change role of #{@user.full_name}" %>

<% breadcrumbs ['Team', admin_team_members_path] %>

<%= admin_form_for @user, url: admin_team_member_path(@user), as: :user do |form| %>
  <%= form.error_notification %>
  <%= form.field_set do %>
    <%= form.input :role, collection: User.roles.keys, include_blank: false, label_method: :humanize %>
  <% end %>
  <%= form.buttons cancel_path: admin_team_members_path %>
<% end %>

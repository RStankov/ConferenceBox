<article id="cfp" data-test="cfp-landing">
  <%= render 'cfp/flash' %>
  <h1>Call for papers</h1>

  <% if @window.nil? %>
    <p>We are not accepting proposals for <%= current_event.full_name %> right now.</p>
  <% else %>
    <p class="cfp-status cfp-status-<%= @window.status %>">
      <strong><%= @window.status_label %></strong>
      <span><%= @window.deadline_sentence %></span>
    </p>

    <% if @window.open? %>
      <p class="cfp-submit">
        <%= link_to 'Submit a proposal', new_cfp_submission_path, class: 'button' %>
        <span>Each speaker can submit up to <%= pluralize @window.max_submissions_per_speaker, 'proposal' %>.</span>
      </p>
    <% end %>

    <% if @window.track_list.any? %>
      <section class="cfp-tracks">
        <h2>Tracks</h2>
        <ul>
          <% @window.track_list.each do |track| %>
            <li><%= track %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if @window.guidelines? %>
      <section class="cfp-guidelines">
        <h2>Guidelines</h2>
        <%= @window.guidelines_html %>
      </section>
    <% end %>

    <% if @window.closed? %>
      <p>Already submitted? Use the link from your confirmation email to check the status of your proposal.</p>
    <% end %>
  <% end %>
</article>

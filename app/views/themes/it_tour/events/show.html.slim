- if @event.show_streaming?
  article#streaming
    h2 Live Streaming

    = raw @event.streaming_code

- if @event.dates_announced?
  article#when
    - if @event.about?
      .about = markdown @event.about

    h2 = @event.formatted_date

    section
      - if @event.finished?
        .status-pill Събитието завърши
      - elsif @event.ongoing?
        .status-pill Събитието тече в момента
      - else
        .timer data-countdown="#{@event.start_time_for_javascript}"

    section
      span.entrance  вход свободен

      - if @event.event_url?
        = link_to ' cъбитието във facebook', @event.event_url, class: 'facebook', target: '_blank'

- if @event.venue_announced?
  article#venue
    h2 Къде?

    .map
      iframe width="100%" height="420" scrolling="no" src="#{@event.venue_map_embedded_url}"
      = link_to '', @event.venue_map_url, target: :blank, class: 'overlay'

    section
      = link_to @event.venue_name, @event.venue_site_url, target: '_blank'
      address = @event.venue_address
      address = markdown @event.venue_notes

- if @event.show_call_to_papers?
  article#call-for-papers
    h1 data-label="Стани лектор" Програма
    section
      p Ако искате да сте лектор на събитието, изпратете ни предложението си за презентация и ще се свържем с вас.
      .link = link_to 'Предложи лекция', @event.call_to_papers_url

- if @event.sessions_announced?
  article#schedule
    h1 data-label=@event.formatted_date Програма

    .schedule-actions
      = add_to_calendar_link @event

    - @event.sessions_by_track.each do |track, sessions|
      section
        - if @event.multi_track?
          h3 Track #{track}

        ul.schedule-cards
          - sessions.each do |session|
            = agenda_slot_tag @event, session do
              time = [session.start_at, session.end_at].compact_blank.join(' – ')
              div
                strong = session.title
                - if session.speakers.any?
                  .speakers = session.speakers.map { link_to _1.name, "#speaker-#{_1.id}" }.join(', ').html_safe
                - if session.video_url? || session.slides_url?
                  .links
                    - if session.video_url?
                      = link_to 'видео', session.video_url, class: 'video', target: '_blank'
                    - if session.slides_url?
                      = link_to 'презентация', session.slides_url, class: 'slides', target: '_blank'
            - @event.breaks_after(session).each do |slot|
              = agenda_break_tag slot

- if @event.speakers_announced?
  article#speakers
    h1 data-label="Кой ще говори" Лектори
    section
      .speaker-grid
        - @event.speakers.each do |speaker|
          section.speaker-card id="speaker-#{speaker.id}"
            - if speaker.photo.attached?
              = link_to image_tag(speaker.photo.variant(resize: '200x200^')), speaker_path(speaker), class: 'avatar'

            h3 = link_to speaker.name, speaker_path(speaker)

            - if speaker.company?
              span.cb-badge = speaker.company

            .content = markdown speaker.description

- if @event.show_photo_gallery?
  article#photos
    h1 data-label="Как беше" Снимки

    section
      .photo-grid
        - @event.photos.ordered.limit(9).each do |photo|
          = image_tag photo.asset.variant(resize: '400'), 'data-src' => "#{url_for(photo.asset)}"

      - if @event.photos.count > 9
        = link_to 'Виж всички снимки', photos_path(@event.name), class: 'more cb-button ghost'

- if @event.after_party_announced?
  article#after-party
    h2 After Party

    - if @event.after_party_venue_map?
      .map
        iframe width="100%" height="420" scrolling="no" src="#{@event.after_party_venue_map_embedded_url}"
        = link_to '', @event.after_party_venue_map_url, target: :blank, class: 'overlay'

    section
      = link_to @event.after_party_venue_name, @event.after_party_venue_site_url, target: '_blank'
      address = @event.after_party_venue_address
      address = @event.after_party_venue_notes

= render 'feedbacks/form' if @event.show_feedback_form?
= render 'shared/archive', events: @event.other_conference_events

<section id="banner">
  <div class="banner-item">
    <div class="container">
      <div class="banner-content text-center">
        <% if current_event.logo? %>
          <div class="banner-logo">
            <%= image_tag current_event.logo.variant(resize: '200'), alt: current_event.conference_name %>
          </div>
        <% end %>
        <% unless current_event.finished? %>
          <div class="timer" data-countdown="<%= current_event.start_time_for_javascript %>"></div>
        <% end %>
        <div>
          <h1 class="banner-title"><%= current_event.conference_name %></h1>
          <h2 class="banner-desc">
            <span class="first"><%= current_event.date.strftime('%d %B %Y') %></span>
          </h2>
          <p class="banner-meta">
            <span><%= current_event.town %></span>
            <% if current_event.venue_announced? %>
              <span><%= current_event.venue_name %></span>
            <% end %>
            <% if current_event.slogan? %>
              <span><%= current_event.slogan %></span>
            <% end %>
          </p>
          <% unless current_event.finished? %>
            <div class="banner-cta">
              <%= link_to 'Facebook Event', current_event.event_url, class: 'btn btn-border', target: :blank if current_event.event_url? %>
              <%= link_to 'Get a Ticket', current_event.tickets_url, class: 'btn btn-primary', target: :blank if current_event.tickets_url? %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

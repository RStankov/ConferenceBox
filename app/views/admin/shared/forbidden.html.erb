<% title 'Access denied' %>

<div class="alert alert-warning" role="alert" data-test="forbidden">
  <p>
    Your account (<%= current_user.role.humanize.downcase %>) does not have access to this page.
    Ask an admin if you think this is a mistake.
  </p>
  <% if current_user.reviewer? %>
    <%= link_to 'Go to your review queue', admin_cfp_reviews_path, class: 'btn btn-light' %>
  <% end %>
</div>

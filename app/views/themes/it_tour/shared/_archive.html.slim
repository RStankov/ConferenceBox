- if events.count > 1
  article#archive
    h1 data-label="Минали издания" Архив
    ul
      - events.each do |event|
        - with_event(event) do |event|
          li
            = link_to image_tag(event.logo.variant(resize: 'x60')), conference_url(event.conference) + archive_path(event.name), class: 'logo' if event.logo.attached?
            h3 = link_to "#{event.conference.name} #{event.name}", conference_url(event.conference) + archive_path(event.name)
            p = event.information
